{
  "name": "condohub-admin",
  "version": "0.2.0",
  "private": true,
  "description": "Micro frontend admin de CondoHub (Angular 18): se monta dentro del shell con mount(el, { getToken, user })",
  "scripts": {
    "entorno": "node scripts/generar-entorno.mjs",
    "prebuild": "npm run entorno",
    "build": "ng build && node -e \"require('fs').renameSync('dist/main.js','dist/remoteEntry.js')\"",
    "dev": "npm run build && node scripts/servir.mjs",
    "preview": "node scripts/servir.mjs",
    "pretest": "npm run entorno",
    "test": "ng test",
    "typecheck": "npm run entorno && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/elements": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "~5.5.2"
  }
}
